# openai@4 declares a peerOptional zod@^3, while this project depends on zod@^4 directly
# (@modelcontextprotocol/sdk and abitype accept either). npm's strict peer resolver refuses the
# tree over that optional peer, so every install here has needed --legacy-peer-deps passed by hand.
# Recording it as config instead means `npm ci` works bare, in CI and in a fresh clone alike, and
# the lockfile is generated under the same resolver that installs it.
legacy-peer-deps=true
