# =============================================================================
# noema (crystal) — environment reference
# =============================================================================
# Generated from the actual `process.env.*` reads in src/ (100 vars). Grouped by
# WHAT BREAKS when the var is absent, because that is the only grouping that
# matters at deploy time.
#
# Read this first — the app's failure posture is deliberate but asymmetric:
#
#   §1 BOOT-FATAL      — process throws on start. Loud. Health check never passes,
#                        deploy.sh aborts the blue-green swap, old container keeps
#                        serving. Safe failure.
#   §2 SILENT-WRONG    — app starts and behaves incorrectly with NO warning.
#                        Exactly one var is in this class. It is the dangerous one.
#   §3 SILENT-DISABLED — app starts, subsystem is off, a log.warn is emitted at
#                        boot. Grep the startup log for "DISABLED" to audit.
#   §4 LAUNCH FLAGS    — fail-closed by default. Unset is the SAFE state.
#   §5 TUNING          — sane defaults, listed for completeness.
#   §6 LEGACY          — NOT read by this app. Present in the long-lived prod .env
#                        from the stationthisdeluxebot era. Documented so nobody
#                        re-adds them thinking they do something.
#
# Naming note: several vars were RENAMED from the legacy app. Same value, new key.
# Setting only the legacy name is silent breakage — see §6 for the mapping.
# =============================================================================


# -----------------------------------------------------------------------------
# §1  BOOT-FATAL — the process throws without these
# -----------------------------------------------------------------------------

# src/index.ts:163 — `if (!MONGODB_URI) throw new Error('MONGODB_URI is required')`
# The Mongo connection string. LEGACY NAME: MONGO_PASS (same value; despite the
# name it is a full URI, not a password). The app reads ONLY MONGODB_URI; the
# migration scripts additionally accept MONGO_PASS as the legacy SOURCE.
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net

# src/index.ts:160 — `if (!BOT_TOKEN) throw new Error('BOT_TOKEN is required')`
# Telegram bot token. LEGACY NAME: TELEGRAM_TOKEN.
BOT_TOKEN=

# src/index.ts:218 — throws if set to a non-positive number. Optional, but if you
# set it, set it validly.
# TEE_AZURE_COST_PER_HR=


# -----------------------------------------------------------------------------
# §2  SILENT-WRONG — starts fine, does the wrong thing, says nothing
# -----------------------------------------------------------------------------

# src/index.ts:165 — `const DB_NAME = process.env.DB_NAME ?? 'noema'`
#
#   !! THE DEFAULT IS THE LEGACY DATABASE. !!
#
# Unset in production => the crystal app connects to the legacy `noema` DB and
# begins writing to it. No error, no warning, health check green.
# Production MUST set this explicitly. LEGACY NAME: MONGO_DB_NAME (which this app
# does NOT read — the legacy app and the migration scripts do).
DB_NAME=noemaplane

# src/index.ts — serve the built React SPA from this process.
#   REQUIRED IN PRODUCTION. Unset ⇒ /api/health is 200 while / and every SPA route 404.
#   Requires the web build to exist (src/platforms/web/app/dist) — the Docker image builds it.
SERVE_WEB_APP=1


# -----------------------------------------------------------------------------
# §3  SILENT-DISABLED — starts, feature is off, boot log warns
# -----------------------------------------------------------------------------

## --- Identity / auth ---------------------------------------------------------
# index.ts:1120 "JWT_SECRET unset — fiat username/password auth is DISABLED
#                (no session minting/verify)"
# Without it NOBODY can log in with username/password. Launch-blocking.
JWT_SECRET=

# Session lifetime override. Unset = the store's built-in default.
# SESSION_TTL_SECONDS=

# Internal-auth shared secret (index.ts:1376). LEGACY NAMES: the five
# INTERNAL_API_KEY_{ADMIN,API,SYSTEM,TELEGRAM,WEB} vars, none of which are read.
INTERNAL_SECRET=

# Public origin used to build absolute URLs. Default 'https://noema.art'.
# PUBLIC_BASE=https://noema.art

# Extra frame-ancestors for the embeddable widget. Default '' (none).
# WIDGET_FRAME_ANCESTORS=

## --- Money: deposits ---------------------------------------------------------
# index.ts:882 "Alchemy price key unset (ALCHEMY_API_KEY / ALCHEMY_KEY) — deposits
#               will NOT be priced (no revenue booked, no credits issued, quote
#               unavailable). Configure before real deposits."
# Resolution order: ALCHEMY_API_KEY ?? ALCHEMY_KEY ?? ALCHEMY_KEY_1
ALCHEMY_API_KEY=

# Webhook signing keys, per chain.
#   base:    ALCHEMY_SIGNING_KEY_8453 ?? ALCHEMY_SIGNING_KEY
#   mainnet: ALCHEMY_SIGNING_KEY_MAINNET ?? ALCHEMY_SIGNING_KEY_1 ?? ALCHEMY_SIGNING_KEY
ALCHEMY_SIGNING_KEY_8453=
# ALCHEMY_SIGNING_KEY_MAINNET=

# On-chain deposit sweep cadence. Default 5 min.
# DEPOSIT_SWEEP_INTERVAL_MS=300000

## --- Money: Stripe (fiat) ----------------------------------------------------
# src/api/webhooks/stripeGateway.ts:38-52 — if EITHER secret is missing,
# stripeConfigFromEnv() returns null and THE ENTIRE PAYMENTS RAIL REPORTS 503.
# Use live keys in prod, test keys on staging. Never share across environments.
STRIPE_SECRET_KEY=
# Signing secret from the Stripe dashboard webhook endpoint. Endpoint URL is
#   https://<host>/v1/payments/stripe/webhook
# Subscribe to BOTH: checkout.session.completed AND payment_intent.succeeded.
# stripeWebhook.ts:164 treats them as the crediting set and dedupes on the shared
# payment_intent id, so a purchase firing both credits exactly once.
STRIPE_WEBHOOK_SECRET=
# Post-checkout redirects. If unset you get a warning + a placeholder
# https://example.invalid/... redirect. Crediting is webhook-driven and unaffected,
# but the buyer lands on a dead page. Set them at go-live.
STRIPE_SUCCESS_URL=https://noema.art/funding?status=success
STRIPE_CANCEL_URL=https://noema.art/funding?status=cancel

## --- Money: x402 -------------------------------------------------------------
# index.ts:1219-1221 — `x402Enabled = X402_ENABLED === 'true' && !!X402_PAY_TO`
# BOTH are required. X402_ENABLED=true with X402_PAY_TO unset = silently OFF.
# LEGACY NAME for the payee: X402_RECEIVER_ADDRESS (not read).
# X402_ENABLED=true
# X402_PAY_TO=0x...
# index.ts:1225 "X402_ENABLED but CDP_API_KEY_ID/CDP_API_KEY_SECRET missing —
#                payments fail closed (deny-stub)"
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

## --- Storage (R2) ------------------------------------------------------------
# index.ts:1134 "R2 unconfigured — storage upload front door DISABLED
#                (/storage/uploads/sign will 404)"
# All three credentials required together, else browser uploads (avatars, banners,
# dataset images) are unavailable.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# PUBLIC outputs bucket — serves the feed/editions, bound to R2_PUBLIC_URL.
# Resolution: R2_OUTPUTS_BUCKET ?? R2_BUCKET_NAME (index.ts:194), so the legacy
# R2_BUCKET_NAME still works. This is the bucket that needs a CORS policy:
#   AllowedOrigins: the prod domains, scheme-exact, no trailing slash
#   AllowedMethods: GET, PUT, HEAD      AllowedHeaders: content-type
#   ExposeHeaders:  ETag                MaxAgeSeconds:  3600
# Browsers PUT directly to R2 with a presigned URL (screens/Datasets.tsx:17-18),
# which triggers a CORS preflight. R2 has no CORS policy by default => uploads fail.
R2_OUTPUTS_BUCKET=
R2_PUBLIC_URL=

# PRIVATE exports bucket — GDPR self-export bundles (index.ts:1145).
# "R2_EXPORTS_BUCKET unset — GDPR self-export DISABLED (POST /v1/me/export will
#  503). Refusing to host PII bundles in the public outputs bucket."
# MUST be a DIFFERENT bucket from the outputs bucket. MUST NOT be bound to a public
# domain. MUST NOT get a CORS policy — the download is an <a href download>
# navigation (screens/AccountSettings.tsx:188), which CORS does not govern.
# Required if ERASURE_ENABLED is going to be turned on.
R2_EXPORTS_BUCKET=

## --- Generation backends -----------------------------------------------------
# RunPod. Without the API key the idle-pod reaper never starts and no pods are
# provisioned.
RUNPOD_API_KEY=
# Verifies inbound RunPod job callbacks. Unset = callbacks unauthenticated.
RUNPOD_WEBHOOK_SECRET=
# SSH key for pods. Prefer RUNPOD_SSH_KEY (base64, materialised on boot — it must
# survive a container RECREATE, see incident 2026-06-19). RUNPOD_SSH_KEY_PATH is
# the on-disk fallback, default ${HOME}/.ssh/runpod.
# LEGACY NAME: RUNPOD_SSH_KEY_DIR (not read).
# RUNPOD_SSH_KEY=
# RUNPOD_SSH_KEY_PATH=

# Weight-proxy rewrite. index.ts:441-444 — WEIGHT_PROXY_BASE self-disables unless
# JOB_TOKEN_SECRET is ALSO set, so a pod is never pointed at a proxy it cannot
# authenticate against. Set both or neither.
# JOB_TOKEN_SECRET=
# WEIGHT_PROXY_BASE=

# Hugging Face — model/LoRA fetch.
HF_TOKEN=

## --- Concierge / agents ------------------------------------------------------
# index.ts:1329 "OPENROUTER_API_KEY unset — concierge endpoints (/v1/colloquia)
#                DISABLED (the read-only tool-use agent cannot run without it)."
OPENROUTER_API_KEY=
# CONCIERGE_MODEL=
# CONCIERGE_TURN_CAP_IMPETUS=

# scripts/concierge-walk.ts — a scripted headless session against a live /v1/colloquia
# deployment, over the anonymous bursa rail. Dev tool only; never read by the app process.
# CONCIERGE_WALK_BASE_URL=
# CONCIERGE_WALK_BURSA_TOKEN=

## --- Search / embeddings -----------------------------------------------------
# index.ts:404 "CLIP_SERVICE_URL not set — vestigium embeddings disabled"
# CLIP_SERVICE_URL=

## --- Permanence --------------------------------------------------------------
# Arweave upload key. Unset = permanence unavailable (index.ts:526).
# ARWEAVE_PRIVATE_KEY=

## --- Telegram ----------------------------------------------------------------
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_BOT_USERNAME=
# General public base for RunPod/runner callbacks; prod derives the webhook URL
# from this. Unset = localhost (dev only).
WEBHOOK_URL=https://noema.art


# -----------------------------------------------------------------------------
# §4  LAUNCH FLAGS — fail-closed. UNSET IS THE SAFE STATE.
# -----------------------------------------------------------------------------
# Do not set any of these "just in case". Each is a deliberate, operator-owned
# go-live decision.

# GDPR Art.17 right-to-erasure: DELETE /v1/me (pseudonymize-and-tombstone).
# Any value other than "true" (incl. unset) = the endpoint 404s.
# Turn on only alongside a working self-export (see R2_EXPORTS_BUCKET above).
# ERASURE_ENABLED=true

# Public feed/marketplace CSAM gate. Fail-closed precedence:
#   real private scanner > MODERATION_MANUAL_REVIEW > MODERATION_ALLOW_UNSCANNED > deny
# With neither flag and no private compliance module, every public publish is
# DENIED (index.ts:827). Private/unlisted publishing is unaffected.
#
# MODERATION_MANUAL_REVIEW=1 — HOLD public publishes for the admin review queue
# instead of denying. Not a detector; files no NCMEC report on its own. Requires
# the operator to actively clear the queue, and requires the reviewer SOP +
# preservation process + NCMEC ESP registration to be in place first.
# MODERATION_MANUAL_REVIEW=1
#
# MODERATION_ALLOW_UNSCANNED=1 — DEV/STAGING ONLY. Approves public content with no
# scanning whatsoever. NEVER set in production.
# MODERATION_ALLOW_UNSCANNED=1

# Anonymous ZK purse. Gated off until the real multi-party arcanum ceremony has
# run and verification_key.json has been swapped — the dev key is FORGEABLE and
# must never go live. index.ts:370 warns when the key is absent.
# ANON_PURSE_ENABLED=true
# ARCANUM_ZKEY_URL=


# -----------------------------------------------------------------------------
# §5  TUNING — defaults are fine; listed so they are discoverable
# -----------------------------------------------------------------------------

# Listen port. Default 3000 — BUT deploy.sh health-checks
# http://<alias>:4000/api/health (deploy.sh:169). Production MUST use 4000 or the
# blue-green swap times out (80 x 5s) and aborts.
PORT=4000

# Health endpoint reports this as `v` (src/index.ts:786). Injected by the release
# workflow at image build; do not set by hand. Default 'dev'.
# BUILD_VERSION=

# PLATFORM_ANIMA_ID=platform          # default 'platform'
# PUBLISH_RATE_LIMIT_MAX=20           # default 20
# PUBLISH_RATE_LIMIT_WINDOW_MS=3600000
# PUBLISH_SCAN_FEE=0                  # default '0'
# EXPIRY_REAPER_INTERVAL_MS=60000
# RUNPOD_CLOUD_TYPE=SECURE            # SECURE | COMMUNITY
# RUNPOD_KEEP_WARM=true               # 'false' disables
# RUNPOD_WARM_TTL_MS=60000
# SLOW_ACTUM_MS=300000
# THROTTLE_MIN_MBPS=20
# THROTTLE_WINDOW_MS=45000
# TEE_READY_WATCHDOG_MS=1200000
# LOG_LEVEL=
# HONEYCOMB_API_KEY=
# HONEYCOMB_DATASET=

# Optional subsystems — leave unset unless in use:
#   TEE_*        Azure confidential compute (TEE_IMAGE_ID enables; the TEE_AZURE_*
#                set is then required)
#   CEREMONY_*   arcanum trusted-setup ceremony tooling
#   AITK_*       remote AITK training image
#   DEV_FAKE_*   simulated pods/images/steps — NEVER set in production
#   ERC8004_*    on-chain agent identity registry
#   SERVE_WEB_APP=1     serve the built web app from this process (documented in §2 above;
#                        STAGING_FRONTEND is a deprecated alias removed after one release)


# -----------------------------------------------------------------------------
# §6  LEGACY — present in long-lived prod .env, NOT read by this app
# -----------------------------------------------------------------------------
# Left here as documentation. Deleting the line does NOT revoke the credential —
# revoke at the provider.
#
# RENAMED (set the NEW name; keep the old one only while the legacy app or the
# migration scripts still need it):
#   MONGO_PASS              -> MONGODB_URI
#   MONGO_DB_NAME           -> DB_NAME
#   TELEGRAM_TOKEN          -> BOT_TOKEN
#   X402_RECEIVER_ADDRESS   -> X402_PAY_TO
#   INTERNAL_API_KEY_*      -> INTERNAL_SECRET
#   RUNPOD_SSH_KEY_DIR      -> RUNPOD_SSH_KEY / RUNPOD_SSH_KEY_PATH
#
# DEAD — no crystal code path reads these:
#   DO_ACCESS_KEY, DO_SECRET_KEY, DO_SPACE_NAME, DO_SPACE_REGION  (pre-R2 storage)
#   COMFY_DEPLOY_API_KEY                                          (ComfyUIDeploy)
#   OPENAI_API, ELEVEN_LABS, TRIPO, VIDU_API_KEY, VIDU_ID         (old vendors)
#   VASTAI_API_KEY, VASTAI_SSH_KEY_PATH                           (old GPU vendor)
#   DISCORD_TOKEN, dlxTELEGRAM_TOKEN, BOT_ID, BOT_NAME
#   TELEGRAM_ADMIN_USER_ID, TELEGRAM_FEEDBACK_CHAT_ID
#   R2_DATASETS_BUCKET, R2_DATASETS_PUBLIC_URL
#   ALCHEMY_KEY_8453, ALCHEMY_SECRET_1, ALCHEMY_SECRET_8453
#   ETHEREUM_RPC_URL, ETHEREUM_CHAIN_ID, BASE_RPC_URL, BASE_CHAIN_ID
#   SEPOLIA_RPC_URL, X402_NETWORK, CORS_EXTRA_ORIGINS, GITHUB_TOKEN
#   CODE, ME, VERISALT
