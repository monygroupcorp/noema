# ComfyUI Deploy API Configuration
# Copy this file to .env and fill in your values

# Required: Your ComfyUI Deploy API key
COMFY_DEPLOY_API_KEY=your-api-key-here

# Optional: ComfyUI Deploy API URL (defaults to https://api.comfydeploy.com)
# Change this if you're using a custom or self-hosted deployment
COMFY_DEPLOY_API_URL=https://api.comfydeploy.com

# Optional: Webhook URL for receiving callback notifications (defaults to http://localhost:3000/api/webhook)
WEBHOOK_URL=http://localhost:3000/api/webhook

# Optional: Request timeout in milliseconds (10 minutes by default)
# TIMEOUT=600000

# Optional: Maximum retry attempts for API requests
# MAX_RETRIES=3

# Optional: Delay between retry attempts in milliseconds
# RETRY_DELAY=6000

# --- GDPR Art. 17 right-to-erasure (noema-025) ---
# Feature flag for DELETE /v1/me (pseudonymize-and-tombstone: severs the caller's PII while
# retaining the anonymized, immutable financial ledger). DEFAULT OFF. Set to "true" ONLY on
# staging for verification. It MUST stay DISABLED in production until legal counsel signs the
# GDPR Art.17(3)(b) pseudonymization-sufficiency determination IN WRITING — the go-live
# checklist owns flipping it. Any value other than "true" (incl. unset) = the endpoint 404s.
# ERASURE_ENABLED=false

# --- Content moderation: →public feed/marketplace CSAM gate (noema-118) ---
# The publish-time trust-boundary gate. Fail-closed by default: with NO private compliance
# module and NEITHER flag below set, every public publish is DENIED (unscanned content never
# goes live). Private/unlisted publishing is unaffected. Precedence, all fail-closed:
#   real private scanner  >  MODERATION_MANUAL_REVIEW  >  MODERATION_ALLOW_UNSCANNED  >  deny.
#
# MODERATION_MANUAL_REVIEW=1 — INTERIM human-review posture. Instead of denying, HOLD every
# public publish for the existing admin review queue (listHeldEditions → Review.tsx), where a
# reviewer explicitly approves / rejects / confirms-CSAM. Nothing auto-publishes and nothing
# auto-rejects. Enabling it OPENS public publishing to the review queue and REQUIRES the operator
# to actively clear that queue. It is NOT a detector and files NO NCMEC report on its own — the
# NCMEC ESP/report/preserve obligation is unchanged and remains the reviewer's explicit
# confirm-csam action. Turning this on in production is a counsel-gated operator decision.
# DEFAULT OFF. Any value other than "1" (incl. unset) = not active.
# MODERATION_MANUAL_REVIEW=1
#
# MODERATION_ALLOW_UNSCANNED=1 — DEV/STAGING ONLY escape hatch: approve public content WITHOUT
# any CSAM/NCMEC scanning. NEVER set in production. DEFAULT OFF.
# MODERATION_ALLOW_UNSCANNED=1 