{
  // Typecheck for the test tree. The root tsconfig's `include` is `src/**/*` only, and the test
  // runner (tsx) strips types without checking them, so `implements` clauses on in-memory doubles
  // under tests/ are not enforced by any step. This config makes them enforced.
  //
  // ENFORCING, over a named first tranche. `include` below is the tranche; the remaining test
  // directories are listed with their measured error counts and each is a follow-on item, so the
  // tranche has a written end state and cannot quietly become a permanent exclusion:
  //
  //   tests/unit/crystal/     164 errors / 42 files  — follow-on items (volume); this directory is
  //                                                    drained in named tranches, not in one pass, so
  //                                                    the row shrinks per tranche and is removed when
  //                                                    the last one lands. The pod/webhook tranche
  //                                                    (RunPodCursor, executionWebhook, webhookRouter,
  //                                                    alchemyWebhook) is now in `include` below.
  //   tests/unit/allocutio/   133 errors / 29 files  — follow-on item (volume)
  //   tests/unit/execution/    83 errors /  6 files  — follow-on item (volume)
  //   tests/unit/arcanum/       7 errors /  3 files  — follow-on item; pulls src/platforms/web/app
  //                                                    into the program (separate package, own tsc)
  //   tests/unit/web/           5 errors /  1 file   — follow-on item; same web-app pull-in
  //   scripts/migrations/       7 errors /  6 files  — not under tests/; its own item
  //
  // Measured against the base commit: 509 errors / 104 files with the whole tree included.
  //
  // src/types/vendor.d.ts is listed explicitly: it carries the ambient module declarations for
  // dependencies that ship no types, and it is only auto-included when `src/**/*` is in `include`.
  // The rest of src/ resolves through imports and does not need to be enumerated here.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "src/types/vendor.d.ts",
    "tests/unit/ledger/**/*",
    "tests/unit/invariants/**/*",
    "tests/unit/api/**/*",
    "tests/unit/flow/**/*",
    "tests/unit/crystal/RunPodCursor.*",
    "tests/unit/crystal/executionWebhook.*",
    "tests/unit/crystal/webhookRouter.*",
    "tests/unit/crystal/alchemyWebhook.*"
  ]
}
