{
  // Typecheck for the test tree. The root tsconfig's `include` is `src/**/*` only, and the test
  // runner (tsx) strips types without checking them, so `implements` clauses on in-memory doubles
  // under tests/ are not enforced by any step. This config makes them enforced.
  //
  // THE MAP — this file accounts for every directory under tests/unit/, exactly once.
  //
  // `include` below is the enforced list. The DEFERRED block is the not-yet-enforced list: one row
  // per directory, carrying its measured error count, and each row is a follow-on item, so a
  // deferral has a written end state and cannot quietly become a permanent exclusion.
  //
  // The two lists together are the map, and `tests/unit/allocutio/api/apiDocsDrift.test.ts`
  // asserts it stays complete and current, in both directions: a directory under tests/unit/ that
  // appears in neither list fails there, naming itself, and a DEFERRED row naming a directory that
  // no longer exists fails as stale. That guard reads the directory listing, so a directory at zero
  // errors is accounted for too — a list derived from measured errors can only describe what
  // failed, never what is uncovered.
  //
  // To add a directory: measure it, and if it is at zero errors put it in `include`; otherwise add
  // a DEFERRED row with the count and open a follow-on item for it.
  //
  // DEFERRED rows go between the two markers below, one per line, shaped
  // `tests/unit/<name>/   <n> errors / <n> files  — <follow-on item>`. The guard parses the region
  // between the markers, so keep them.
  //
  // DEFERRED-BEGIN
  //   (none — every directory is named in `include` below)
  // DEFERRED-END
  //
  // Outside tests/unit/, so outside the map above and outside that guard:
  //
  //   scripts/migrations/       2 errors /  2 files  — not under tests/; its own item
  //
  // tests/unit/arcanum/ and tests/unit/web/ are in `include`. Their suites import eight
  // modules from src/platforms/web/app/src/lib, so those files enter this program and are
  // typechecked here under this config's options. They are READ ONLY from here: that package
  // keeps its own tsconfig, its own `tsc --noEmit` and its own test runner, and the root
  // tsconfig still excludes it. A type error in one of them is a finding for that package,
  // not something to fix from this side.
  //
  // src/types/vendor.d.ts is listed explicitly: it carries the ambient module declarations for
  // dependencies that ship no types, and it is only auto-included when `src/**/*` is in `include`.
  // The rest of src/ resolves through imports and does not need to be enumerated here.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // The root config compiles src/ to CommonJS for `dist/`. The test tree is never emitted — it is
    // executed by tsx as ES modules and reads `import.meta.url` to locate fixtures — so the test
    // program is checked as ESM. Module RESOLUTION is inherited from the root config, unchanged.
    "module": "ESNext"
  },
  "include": [
    "src/types/vendor.d.ts",
    "tests/unit/ledger/**/*",
    "tests/unit/invariants/**/*",
    "tests/unit/api/**/*",
    "tests/unit/flow/**/*",
    "tests/unit/execution/**/*",
    "tests/unit/crystal/**/*",
    "tests/unit/arcanum/**/*",
    "tests/unit/web/**/*",
    "tests/unit/allocutio/**/*",
    "tests/unit/analytics/**/*",
    "tests/unit/architecture/**/*",
    "tests/unit/lib/**/*",
    "tests/unit/migrations/**/*",
    "tests/unit/rag/**/*"
  ]
}
