{
  "templateId": "sdxl-canny",
  "version": "1",
  "status": "DRAFT — not registered, not runnable",
  "blocked": "BLOCKED: needs i2i image-input primitive (control image); declare the t2i-adapter-canny-sdxl-1.0 controlnet weight on promote (Canny + ControlNetApplyAdvanced are core — no pack)",
  "categoriaHint": "image — SDXL Canny ControlNet → effect (decomposed from the sdxlplus combo)",
  "provenance": "Decomposed from docs/reference/old-workflows/sdxlplus (the Canny/control-image branch). rgthree Any-Switch multiplexers removed — clean linear graph for the single control flavor.",
  "seedInputKey": "input_seed",
  "loraCapable": true,
  "customNodes": [
    { "url": "https://github.com/skfoo/ComfyUI-Coziness", "name": "ComfyUI-Coziness" }
  ],
  "aditus": {
    "prompt":     { "type": "text",  "required": true,  "description": "Text prompt" },
    "image":      { "type": "image", "required": true,  "description": "Control image — its Canny edges constrain the composition" },
    "width":      { "type": "int",   "default": 1024,   "description": "Output width" },
    "height":     { "type": "int",   "default": 1024,   "description": "Output height" },
    "steps":      { "type": "int",   "default": 30,     "description": "Inference steps" },
    "guidance":   { "type": "float", "default": 7,      "description": "CFG guidance scale" },
    "input_seed": { "type": "int",                      "description": "Random seed — omit to shuffle" }
  },
  "exitus": { "image": { "type": "image", "description": "Generated image, composition-locked to the control edges" } },
  "slotMap": {
    "/3/inputs/seed":    "input_seed",
    "/3/inputs/steps":   "steps",
    "/3/inputs/cfg":     "guidance",
    "/97/inputs/width":  "width",
    "/97/inputs/height": "height",
    "/47/inputs/text":   "prompt",
    "/10/inputs/image":  "image"
  },
  "inputTemplate": {
    "4":   { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" } },
    "47":  { "class_type": "LoraTextExtractor-b1f83aa2", "inputs": { "text": "PLACEHOLDER" } },
    "46":  { "class_type": "MultiLoraLoader-70bf3d77", "inputs": { "model": ["4", 0], "clip": ["4", 1], "text": ["47", 1] } },
    "6":   { "class_type": "CLIPTextEncode", "inputs": { "clip": ["46", 1], "text": ["47", 0] } },
    "7":   { "class_type": "CLIPTextEncode", "inputs": { "clip": ["46", 1], "text": "" } },
    "10":  { "class_type": "LoadImage", "inputs": { "image": "PLACEHOLDER" } },
    "111": { "class_type": "Canny", "inputs": { "image": ["10", 0], "low_threshold": 0.4, "high_threshold": 0.8 } },
    "113": { "class_type": "ControlNetLoader", "inputs": { "control_net_name": "t2i-adapter-canny-sdxl-1.0.safetensors" } },
    "112": { "class_type": "ControlNetApplyAdvanced", "inputs": { "positive": ["6", 0], "negative": ["7", 0], "image": ["111", 0], "control_net": ["113", 0], "strength": 1, "start_percent": 0, "end_percent": 1 } },
    "97":  { "class_type": "EmptyLatentImage", "inputs": { "width": 1024, "height": 1024, "batch_size": 1 } },
    "3":   { "class_type": "KSampler", "inputs": { "seed": 88888888, "steps": 30, "cfg": 7, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1, "model": ["46", 0], "positive": ["112", 0], "negative": ["112", 1], "latent_image": ["97", 0] } },
    "8":   { "class_type": "VAEDecode", "inputs": { "samples": ["3", 0], "vae": ["4", 2] } },
    "9":   { "class_type": "SaveImage", "inputs": { "images": ["8", 0], "filename_prefix": "runmake" } }
  }
}
