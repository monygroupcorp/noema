{
  "templateId": "sdxl-plus",
  "version": "1",
  "status": "DRAFT — not registered, not runnable",
  "blocked": "BLOCKED: needs (1) i2i image-input primitive AND (2) Compiler optional-branch pruning (see docs/spec/optional-conditioning-pruning.md). Packs on promote: ComfyUI_IPAdapter_plus, ComfyUI-OpenPose.",
  "categoriaHint": "image — unified SDXL conditioning: prompt + ANY subset of {style, canny, pose} images → effect",
  "provenance": "The CLEAN re-expression of docs/reference/old-workflows/sdxlplus. The old combo multiplexed 3 image modes with rgthree Any-Switch nodes (and always-on IPAdapter — the 'overloaded' bug). Here each conditioning branch is an OPTIONAL aditus; absent branches are pruned at compile time (no Any Switch, no rgthree). style+pose / canny+style / any combination = this one flow.",
  "seedInputKey": "input_seed",
  "loraCapable": true,
  "customNodes": [
    { "url": "https://github.com/skfoo/ComfyUI-Coziness", "name": "ComfyUI-Coziness" },
    { "url": "https://github.com/cubiq/ComfyUI_IPAdapter_plus", "name": "ComfyUI_IPAdapter_plus" },
    { "url": "https://github.com/alessandrozonta/ComfyUI-OpenPose", "name": "ComfyUI-OpenPose" }
  ],
  "aditus": {
    "prompt":      { "type": "text",  "required": true,  "description": "Text prompt" },
    "style_image": { "type": "image", "required": false, "description": "Style reference → IPAdapter (omit to skip)" },
    "canny_image": { "type": "image", "required": false, "description": "Structure reference → Canny ControlNet (omit to skip)" },
    "pose_image":  { "type": "image", "required": false, "description": "Pose reference → OpenPose ControlNet (omit to skip)" },
    "width":       { "type": "int",   "default": 1024,   "description": "Output width" },
    "height":      { "type": "int",   "default": 1024,   "description": "Output height" },
    "steps":       { "type": "int",   "default": 30,     "description": "Inference steps" },
    "guidance":    { "type": "float", "default": 7,      "description": "CFG guidance scale" },
    "input_seed":  { "type": "int",                      "description": "Random seed — omit to shuffle" }
  },
  "exitus": { "image": { "type": "image", "description": "Generated image with whichever conditionings were supplied" } },
  "slotMap": {
    "/3/inputs/seed":    "input_seed",
    "/3/inputs/steps":   "steps",
    "/3/inputs/cfg":     "guidance",
    "/97/inputs/width":  "width",
    "/97/inputs/height": "height",
    "/47/inputs/text":   "prompt",
    "/20/inputs/image":  "style_image",
    "/30/inputs/image":  "canny_image",
    "/40/inputs/image":  "pose_image"
  },
  "conditionalBranches": {
    "_comment": "Read by the Compiler optional-branch-pruning pass. When the optional aditus is ABSENT: drop `nodes`, then redirect every surviving link that points at a dropped node's `[id, out]` to its `passthrough[id][out]` fallback — resolving TRANSITIVELY (if the fallback is itself a dropped node, follow its passthrough). Transitive resolution is what makes composed prunes correct, e.g. canny+pose both absent → KSampler falls through 82→112→[6]/[7]. See docs/spec/optional-conditioning-pruning.md.",
    "style_image": {
      "nodes": ["20", "73", "72"],
      "passthrough": { "72": { "0": ["46", 0] } }
    },
    "canny_image": {
      "nodes": ["30", "111", "113", "112"],
      "passthrough": { "112": { "0": ["6", 0], "1": ["7", 0] } }
    },
    "pose_image": {
      "nodes": ["40", "144", "81", "82"],
      "passthrough": { "82": { "0": ["112", 0], "1": ["112", 1] } }
    }
  },
  "inputTemplate": {
    "4":   { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" } },
    "47":  { "class_type": "LoraTextExtractor-b1f83aa2", "inputs": { "text": "PLACEHOLDER" } },
    "46":  { "class_type": "MultiLoraLoader-70bf3d77", "inputs": { "model": ["4", 0], "clip": ["4", 1], "text": ["47", 1] } },
    "6":   { "class_type": "CLIPTextEncode", "inputs": { "clip": ["46", 1], "text": ["47", 0] } },
    "7":   { "class_type": "CLIPTextEncode", "inputs": { "clip": ["46", 1], "text": "" } },

    "20":  { "class_type": "LoadImage", "inputs": { "image": "PLACEHOLDER" } },
    "73":  { "class_type": "IPAdapterUnifiedLoader", "inputs": { "model": ["46", 0], "preset": "STANDARD (medium strength)" } },
    "72":  { "class_type": "IPAdapterAdvanced", "inputs": { "model": ["73", 0], "ipadapter": ["73", 1], "image": ["20", 0], "weight": 1, "start_at": 0, "end_at": 1, "weight_type": "strong style transfer", "combine_embeds": "concat", "embeds_scaling": "V only" } },

    "30":  { "class_type": "LoadImage", "inputs": { "image": "PLACEHOLDER" } },
    "111": { "class_type": "Canny", "inputs": { "image": ["30", 0], "low_threshold": 0.4, "high_threshold": 0.8 } },
    "113": { "class_type": "ControlNetLoader", "inputs": { "control_net_name": "t2i-adapter-canny-sdxl-1.0.safetensors" } },
    "112": { "class_type": "ControlNetApplyAdvanced", "inputs": { "positive": ["6", 0], "negative": ["7", 0], "image": ["111", 0], "control_net": ["113", 0], "strength": 1, "start_percent": 0, "end_percent": 1 } },

    "40":  { "class_type": "LoadImage", "inputs": { "image": "PLACEHOLDER" } },
    "144": { "class_type": "OpenPose - Get poses", "inputs": { "typology": "COCO", "input_image": ["40", 0], "transparency": 0.1 } },
    "81":  { "class_type": "ControlNetLoader", "inputs": { "control_net_name": "t2i-adapter-openpose-sdxl-1.0.safetensors" } },
    "82":  { "class_type": "ControlNetApplyAdvanced", "inputs": { "positive": ["112", 0], "negative": ["112", 1], "image": ["144", 1], "control_net": ["81", 0], "strength": 1, "start_percent": 0, "end_percent": 1 } },

    "97":  { "class_type": "EmptyLatentImage", "inputs": { "width": 1024, "height": 1024, "batch_size": 1 } },
    "3":   { "class_type": "KSampler", "inputs": { "seed": 88888888, "steps": 30, "cfg": 7, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1, "model": ["72", 0], "positive": ["82", 0], "negative": ["82", 1], "latent_image": ["97", 0] } },
    "8":   { "class_type": "VAEDecode", "inputs": { "samples": ["3", 0], "vae": ["4", 2] } },
    "9":   { "class_type": "SaveImage", "inputs": { "images": ["8", 0], "filename_prefix": "runmake" } }
  }
}
