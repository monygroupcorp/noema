    "73": { "class_type": "IPAdapterUnifiedLoader", "inputs": { "model": ["46", 0], "preset": "STANDARD (medium strength)" } },
    "72": { "class_type": "IPAdapterAdvanced", "inputs": { "model": ["73", 0], "ipadapter": ["73", 1], "image": ["10", 0], "weight": 1, "start_at": 0, "end_at": 1, "weight_type": "strong style transfer", "combine_embeds": "concat", "embeds_scaling": "V only" } },
    "97": { "class_type": "EmptyLatentImage", "inputs": { "width": 1024, "height": 1024, "batch_size": 1 } },
    "3":  { "class_type": "KSampler", "inputs": { "seed": 88888888, "steps": 30, "cfg": 7, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1, "model": ["72", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["97", 0] } },
    "8":  { "class_type": "VAEDecode", "inputs": { "samples": ["3", 0], "vae": ["4", 2] } },
    "9":  { "class_type": "SaveImage", "inputs": { "images": ["8", 0], "filename_prefix": "runmake" } }
  }
