{
  "templateId": "klein",
  "version": "1",
  "displayName": "FLUX.2 Klein 4B — text to image (LoRA-capable)",
  "seedInputKey": "input_seed",
  "loraCapable": true,
  "customNodes": [
    { "url": "https://github.com/skfoo/ComfyUI-Coziness", "name": "ComfyUI-Coziness" }
  ],
  "inputTemplate": {
    "70": { "class_type": "UNETLoader",             "inputs": { "unet_name": "flux-2-klein-4b-fp8.safetensors", "weight_dtype": "default" } },
    "71": { "class_type": "CLIPLoader",             "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "flux2", "device": "default" } },
    "72": { "class_type": "VAELoader",              "inputs": { "vae_name": "full_encoder_small_decoder.safetensors" } },
    "200": { "class_type": "LoraTextExtractor-b1f83aa2", "inputs": { "text": "PLACEHOLDER" } },
    "201": { "class_type": "MultiLoraLoader-70bf3d77",   "inputs": { "model": ["70", 0], "clip": ["71", 0], "text": ["200", 1] } },
    "74": { "class_type": "CLIPTextEncode",         "inputs": { "clip": ["201", 1], "text": ["200", 0] } },
    "82": { "class_type": "ConditioningZeroOut",    "inputs": { "conditioning": ["74", 0] } },
    "63": { "class_type": "CFGGuider",              "inputs": { "model": ["201", 0], "positive": ["74", 0], "negative": ["82", 0], "cfg": 3 } },
    "62": { "class_type": "Flux2Scheduler",         "inputs": { "steps": 9, "width": 1024, "height": 1024 } },
    "66": { "class_type": "EmptyFlux2LatentImage",  "inputs": { "width": 1024, "height": 1024, "batch_size": 1 } },
    "61": { "class_type": "KSamplerSelect",         "inputs": { "sampler_name": "euler" } },
    "73": { "class_type": "RandomNoise",            "inputs": { "noise_seed": 88888888 } },
    "64": { "class_type": "SamplerCustomAdvanced",  "inputs": { "noise": ["73", 0], "guider": ["63", 0], "sampler": ["61", 0], "sigmas": ["62", 0], "latent_image": ["66", 0] } },
    "65": { "class_type": "VAEDecode",              "inputs": { "samples": ["64", 0], "vae": ["72", 0] } },
    "9":  { "class_type": "SaveImage",              "inputs": { "images": ["65", 0], "filename_prefix": "runmake" } }
  },
  "slotMap": {
    "/73/inputs/noise_seed": "input_seed",
    "/62/inputs/steps":      "steps",
    "/63/inputs/cfg":        "guidance",
    "/200/inputs/text":      "prompt",
    "/62/inputs/width":      "width",
    "/62/inputs/height":     "height",
    "/66/inputs/width":      "width",
    "/66/inputs/height":     "height"
  },
  "requiredModels": [
    { "role": "unet", "id": "intella.flux2-klein-4b", "url": "https://huggingface.co/black-forest-labs/FLUX.2-klein-4b-fp8/resolve/main/flux-2-klein-4b-fp8.safetensors", "dest": "diffusion_models/flux-2-klein-4b-fp8.safetensors" },
    { "role": "clip", "id": "intella.qwen3-4b-flux2", "url": "https://huggingface.co/Comfy-Org/vae-text-encorder-for-flux-klein-4b/resolve/main/split_files/text_encoders/qwen_3_4b.safetensors", "dest": "text_encoders/qwen_3_4b.safetensors" },
    { "role": "vae",  "id": "intella.flux2-vae-full-encoder", "url": "https://huggingface.co/black-forest-labs/FLUX.2-small-decoder/resolve/main/full_encoder_small_decoder.safetensors", "dest": "vae/full_encoder_small_decoder.safetensors" }
  ],
  "platformHints": { "vramGb": 24 }
}
