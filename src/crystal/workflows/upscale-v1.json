{
  "templateId": "upscale",
  "version": "1",
  "displayName": "Image upscale (4x-UltraSharp, model-only)",
  "loraCapable": false,
  "customNodes": [],
  "inputTemplate": {
    "10": { "class_type": "LoadImage",             "inputs": { "image": "PLACEHOLDER" } },
    "32": { "class_type": "UpscaleModelLoader",     "inputs": { "model_name": "4x-UltraSharp.pth" } },
    "35": { "class_type": "ImageUpscaleWithModel",  "inputs": { "upscale_model": ["32", 0], "image": ["10", 0] } },
    "9":  { "class_type": "SaveImage",              "inputs": { "images": ["35", 0], "filename_prefix": "upscale" } }
  },
  "slotMap": {
    "/10/inputs/image": "image"
  },
  "requiredModels": [
    { "role": "upscale_model", "id": "intella.upscale-4x-ultrasharp", "url": "https://huggingface.co/lokCX/4x-Ultrasharp/resolve/main/4x-UltraSharp.pth", "dest": "upscale_models/4x-UltraSharp.pth" }
  ],
  "platformHints": { "vramGb": 6 }
}
