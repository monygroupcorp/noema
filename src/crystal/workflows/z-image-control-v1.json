{
  "templateId": "z-image-control",
  "version": "1",
  "displayName": "Z-Image Turbo — Canny control (1024px, 8 steps)",
  "seedInputKey": "input_seed",
  "loraCapable": true,
  "upstream": {
    "template": "image_z_image_turbo_fun_union_controlnet",
    "note": "converted from the upstream graph: LoadImage → ImageScaleToMaxDimension → Canny feeds ModelPatchLoader + QwenImageDiffsynthControlnet over the Z-Image DiT. The output size follows the control image (GetImageSize) rather than a width/height input, as upstream has it. Coziness multi-LoRA is crystal's addition, on the same familia as z-image-turbo."
  },
  "customNodes": [
    { "url": "https://github.com/skfoo/ComfyUI-Coziness", "name": "ComfyUI-Coziness" }
  ],
  "inputTemplate": {
    "1":  { "class_type": "LoadImage",                  "inputs": { "image": "PLACEHOLDER" } },
    "2":  { "class_type": "ImageScaleToMaxDimension",   "inputs": { "upscale_method": "lanczos", "max_dimension": 1024, "image": ["1", 0] } },
    "3":  { "class_type": "Canny",                      "inputs": { "low_threshold": 0.1, "high_threshold": 0.32, "image": ["2", 0] } },
    "4":  { "class_type": "GetImageSize",               "inputs": { "image": ["3", 0] } },
    "6":  { "class_type": "EmptySD3LatentImage",        "inputs": { "batch_size": 1, "width": ["4", 0], "height": ["4", 1] } },
    "8":  { "class_type": "VAEDecode",                  "inputs": { "samples": ["13", 0], "vae": ["10", 0] } },
    "9":  { "class_type": "SaveImage",                  "inputs": { "filename_prefix": "runmake", "images": ["8", 0] } },
    "10": { "class_type": "VAELoader",                  "inputs": { "vae_name": "ae.safetensors" } },
    "11": { "class_type": "CLIPLoader",                 "inputs": { "type": "lumina2", "device": "default", "clip_name": "qwen_3_4b.safetensors" } },
    "12": { "class_type": "UNETLoader",                 "inputs": { "unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "default" } },
    "13": { "class_type": "KSampler",                   "inputs": { "seed": 88888888, "steps": 8, "cfg": 1, "sampler_name": "res_multistep", "scheduler": "simple", "denoise": 1, "model": ["17", 0], "positive": ["22", 0], "negative": ["23", 0], "latent_image": ["6", 0] } },
    "15": { "class_type": "ModelPatchLoader",           "inputs": { "name": "Z-Image-Turbo-Fun-Controlnet-Union.safetensors" } },
    "16": { "class_type": "QwenImageDiffsynthControlnet","inputs": { "strength": 1, "model": ["21", 0], "model_patch": ["15", 0], "vae": ["10", 0], "image": ["3", 0] } },
    "17": { "class_type": "ModelSamplingAuraFlow",      "inputs": { "shift": 3, "model": ["16", 0] } },
    "20": { "class_type": "LoraTextExtractor-b1f83aa2", "inputs": { "text": "PLACEHOLDER" } },
    "21": { "class_type": "MultiLoraLoader-70bf3d77",   "inputs": { "model": ["12", 0], "clip": ["11", 0], "text": ["20", 1] } },
    "22": { "class_type": "CLIPTextEncode",             "inputs": { "clip": ["21", 1], "text": ["20", 0] } },
    "23": { "class_type": "ConditioningZeroOut",        "inputs": { "conditioning": ["22", 0] } }
  },
  "slotMap": {
    "/13/inputs/seed":            "input_seed",
    "/13/inputs/steps":           "steps",
    "/13/inputs/cfg":             "guidance",
    "/1/inputs/image":            "image",
    "/20/inputs/text":            "prompt",
    "/2/inputs/max_dimension":    "max_dimension",
    "/3/inputs/low_threshold":    "canny_low",
    "/3/inputs/high_threshold":   "canny_high",
    "/16/inputs/strength":        "control_strength"
  },
  "requiredModels": [
    { "role": "unet",        "id": "intella.z-image-turbo",                 "url": "https://models.miladystation2.net/diffusion_models/z_image_turbo_bf16.safetensors", "dest": "diffusion_models/z_image_turbo_bf16.safetensors" },
    { "role": "clip",        "id": "intella.qwen3-4b",                      "url": "https://models.miladystation2.net/clip/qwen_3_4b.safetensors", "dest": "clip/qwen_3_4b.safetensors" },
    { "role": "vae",         "id": "intella.flux-vae",                      "url": "https://models.miladystation2.net/vae/ae.safetensors", "dest": "vae/ae.safetensors" },
    { "role": "model_patch", "id": "intella.z-image-fun-controlnet-union",  "url": "https://huggingface.co/alibaba-pai/Z-Image-Turbo-Fun-Controlnet-Union/resolve/main/Z-Image-Turbo-Fun-Controlnet-Union.safetensors", "dest": "model_patches/Z-Image-Turbo-Fun-Controlnet-Union.safetensors" }
  ],
  "platformHints": { "vramGb": 24, "expectedSteps": 8 }
}
