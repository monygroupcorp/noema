{
  "templateId": "ltx-t2v",
  "version": "1",
  "displayName": "LTX 2.3 — text to video (832x544, 81 frames, 16fps)",
  "seedInputKey": "input_seed",
  "loraCapable": false,
  "customNodes": [
    { "url": "https://github.com/Lightricks/ComfyUI-LTXVideo", "name": "ComfyUI-LTXVideo" }
  ],
  "inputTemplate": {
    "1":  { "class_type": "CheckpointLoaderSimple",   "inputs": { "ckpt_name": "ltx-2.3-22b-distilled.safetensors" } },
    "2":  { "class_type": "LTXAVTextEncoderLoader",   "inputs": { "text_encoder": "gemma_3_12B_it.safetensors", "ckpt_name": "ltx-2.3-22b-distilled.safetensors", "device": "default" } },
    "3":  { "class_type": "CLIPTextEncode",            "inputs": { "text": "PLACEHOLDER", "clip": ["2", 0] } },
    "4":  { "class_type": "CLIPTextEncode",            "inputs": { "text": "", "clip": ["2", 0] } },
    "5":  { "class_type": "LTXVConditioning",          "inputs": { "positive": ["3", 0], "negative": ["4", 0], "frame_rate": 16 } },
    "6":  { "class_type": "EmptyLTXVLatentVideo",      "inputs": { "width": 832, "height": 544, "length": 81, "batch_size": 1 } },
    "7":  { "class_type": "RandomNoise",                "inputs": { "noise_seed": 88888888 } },
    "8":  { "class_type": "KSamplerSelect",             "inputs": { "sampler_name": "euler" } },
    "9":  { "class_type": "LTXVScheduler",              "inputs": { "steps": 20, "max_shift": 2.05, "base_shift": 0.95, "stretch": true, "terminal": 0.1, "latent": ["6", 0] } },
    "10": { "class_type": "CFGGuider",                  "inputs": { "model": ["1", 0], "positive": ["5", 0], "negative": ["5", 1], "cfg": 3 } },
    "11": { "class_type": "SamplerCustomAdvanced",      "inputs": { "noise": ["7", 0], "guider": ["10", 0], "sampler": ["8", 0], "sigmas": ["9", 0], "latent_image": ["6", 0] } },
    "12": { "class_type": "LTXVTiledVAEDecode",         "inputs": { "vae": ["1", 2], "latents": ["11", 0], "horizontal_tiles": 2, "vertical_tiles": 2, "overlap": 6, "last_frame_fix": false } },
    "13": { "class_type": "CreateVideo",                 "inputs": { "images": ["12", 0], "fps": 16 } },
    "14": { "class_type": "SaveVideo",                   "inputs": { "video": ["13", 0], "filename_prefix": "runmake", "format": "auto", "codec": "auto" } }
  },
  "slotMap": {
    "/3/inputs/text":     "prompt",
    "/4/inputs/text":     "negative",
    "/6/inputs/length":   "frames",
    "/7/inputs/noise_seed": "input_seed"
  },
  "requiredModels": [
    { "role": "checkpoint",    "id": "intella.ltx-2.3-distilled", "url": "https://huggingface.co/Lightricks/LTX-2.3/resolve/main/ltx-2.3-22b-distilled.safetensors", "dest": "checkpoints/ltx-2.3-22b-distilled.safetensors" },
    { "role": "text_encoder",  "id": "intella.gemma-3-12b",       "url": "https://huggingface.co/Comfy-Org/ltx-2/resolve/main/split_files/text_encoders/gemma_3_12B_it.safetensors", "dest": "text_encoders/gemma_3_12B_it.safetensors" }
  ],
  "platformHints": { "vramGb": 48 }
}
