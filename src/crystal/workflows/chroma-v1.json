{
  "templateId": "chroma",
  "version": "1",
  "displayName": "Chroma text-to-image (1024x1024, 26 steps)",
  "seedInputKey": "input_seed",
  "loraCapable": true,
  "customNodes": [
    { "url": "https://github.com/skfoo/ComfyUI-Coziness", "name": "ComfyUI-Coziness" }
  ],
  "inputTemplate": {
    "67": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["68", 0], "guider": ["73", 0], "sigmas": ["84", 0], "sampler": ["72", 0], "latent_image": ["69", 0] } },
    "68": { "class_type": "RandomNoise",           "inputs": { "noise_seed": 666 } },
    "69": { "class_type": "EmptySD3LatentImage",   "inputs": { "width": 1024, "height": 1024, "batch_size": 1 } },
    "72": { "class_type": "KSamplerSelect",        "inputs": { "sampler_name": "euler" } },
    "73": { "class_type": "CFGGuider",             "inputs": { "cfg": 4, "model": ["86", 0], "negative": ["75", 0], "positive": ["74", 0] } },
    "74": { "class_type": "CLIPTextEncode",        "inputs": { "clip": ["86", 1], "text": ["87", 0] } },
    "75": { "class_type": "CLIPTextEncode",        "inputs": { "clip": ["86", 1], "text": "low quality, ugly, unfinished, out of focus, deformed, disfigure, blurry, smudged, restricted palette, flat colors" } },
    "76": { "class_type": "UNETLoader",            "inputs": { "unet_name": "chroma-unlocked-v35.safetensors", "weight_dtype": "default" } },
    "78": { "class_type": "CLIPLoader",            "inputs": { "type": "chroma", "device": "default", "clip_name": "t5xxl_fp16.safetensors" } },
    "79": { "class_type": "VAEDecode",             "inputs": { "vae": ["80", 0], "samples": ["67", 0] } },
    "80": { "class_type": "VAELoader",             "inputs": { "vae_name": "ae.safetensors" } },
    "81": { "class_type": "SaveImage",             "inputs": { "images": ["79", 0], "filename_prefix": "runmake" } },
    "84": { "class_type": "BasicScheduler",        "inputs": { "model": ["76", 0], "steps": 26, "denoise": 1, "scheduler": "beta" } },
    "86": { "class_type": "MultiLoraLoader-70bf3d77",   "inputs": { "clip": ["78", 0], "text": ["87", 1], "model": ["76", 0] } },
    "87": { "class_type": "LoraTextExtractor-b1f83aa2", "inputs": { "text": "PLACEHOLDER" } }
  },
  "slotMap": {
    "/68/inputs/noise_seed": "input_seed",
    "/84/inputs/steps":      "steps",
    "/73/inputs/cfg":        "guidance",
    "/69/inputs/width":      "width",
    "/69/inputs/height":     "height",
    "/87/inputs/text":       "prompt"
  },
  "requiredModels": [
    { "role": "unet", "id": "intella.chroma-unlocked-v35", "url": "https://huggingface.co/lodestones/Chroma/resolve/main/chroma-unlocked-v35.safetensors", "dest": "unet/chroma-unlocked-v35.safetensors" },
    { "role": "clip", "id": "intella.t5xxl-fp16", "url": "https://huggingface.co/comfyanonymous/flux_text_encoders/resolve/main/t5xxl_fp16.safetensors", "dest": "clip/t5xxl_fp16.safetensors" },
    { "role": "vae",  "id": "intella.flux-vae", "url": "https://huggingface.co/black-forest-labs/FLUX.1-schnell/resolve/main/ae.safetensors", "dest": "vae/ae.safetensors" }
  ],
  "platformHints": { "vramGb": 24 }
}
