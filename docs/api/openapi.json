              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "flows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "nomen": {
                            "type": "string",
                            "description": "The flow display name."
                          },
                          "versio": {
                            "type": "string",
                            "description": "The flow version."
                          },
                          "categoria": {
                            "description": "An optional catalog tag."
                          }
                        },
