                "type": "string"
              },
              "retryable": {
                "type": "boolean",
                "description": "Whether the same call may succeed if retried."
              },
              "retryAfter": {
                "type": "number",
                "description": "Suggested back-off in seconds."
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
